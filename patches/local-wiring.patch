+++ b/packages/bundle/base/cordis.patch.yml
@@ -449,3 +449,18 @@
     # choice.
     - id: llm-deepseek
       name: '@deepseek-ai/dsh-llm-deepseek'
+
+    # The web-edition DeepSeek adapter (chat.deepseek.com): no API key — the
+    # route resolves a captured browser login (storageStatePath) or a session
+    # token per request and speaks the web app's internal protocol. Registered
+    # at load like the official adapter; requests fail with a clear
+    # MISSING_CREDENTIAL until `llm-deepseek-web:` settings configure a session.
+    - id: llm-deepseek-web
+      name: '@deepseek-ai/dsh-llm-deepseek-web'
+
+    # The local Ollama adapter. No key or endpoint is inlined: the server root
+    # resolves per request from the `llm-ollama:` settings section over this entry
+    # (defaults to http://localhost:11434), and the model catalog comes from
+    # `/api/tags` unless a static `models` list is supplied.
+    - id: llm-ollama
+      name: '@deepseek-ai/dsh-llm-ollama'
